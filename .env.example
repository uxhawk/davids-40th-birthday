# Copy to .env.local for local dev; set the same keys in Vercel for production.
# Everything is optional locally: with nothing set, the app uses a file-based
# database in .data/, prints emails to the terminal, and skips the captcha.

# Public URL of the site, used for links in emails (no trailing slash).
SITE_URL=http://localhost:3000

# Admin area (/admin). Use a long random password and a separate random secret.
ADMIN_PASSWORD=
SESSION_SECRET=

# Postgres connection string (Neon). Unset = local PGlite database in .data/.
DATABASE_URL=

# Resend. Unset = emails are logged to the terminal instead of sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Until you have a domain,
# onboarding@resend.dev works but only delivers to your own Resend account email.
EMAIL_FROM="David's 40th <onboarding@resend.dev>"
# Where RSVP notifications go, and the reply-to on guest emails.
ADMIN_EMAIL=

# Cloudflare Turnstile captcha. Unset = captcha is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps Embed API key. Unset = keyless embed (works, fewer options).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
